[Unit]
Description=Watch CLI-Proxy auth directories for lock file cleanup
# A path unit does not recurse, so each auth directory is listed. The service disables its start
# limit (StartLimitIntervalSec=0) so a burst of changes cannot fail this unit.

[Path]
PathChanged=%h/.local/share/cli-proxy-api/auth
PathChanged=%h/.local/share/cli-proxy-claude/auth
Unit=prox-auth-janitor.service

[Install]
WantedBy=default.target
