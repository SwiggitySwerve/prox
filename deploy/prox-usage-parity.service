# Template only. Do not install or enable until the coordinator has reviewed the paths.
[Unit]
Description=Prox usage parity evidence for the previous UTC day
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/prox
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/ionice -c3 /usr/bin/nice -n10 bun scripts/usage-parity.ts --previous-utc-day --matrix quick --level both
KillSignal=SIGINT
TimeoutStopSec=40
