# Manual-use unit, installed by scripts/deploy-homelab.sh. Runs the deployed bundle, never a checkout.
[Unit]
Description=Prox usage parity evidence for the previous UTC day
After=network-online.target
Wants=network-online.target

[Service]
# RuntimeMaxSec is effective for exec services, not oneshot services.
Type=exec
WorkingDirectory=%h/.local/share/prox/usage-jobs
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=PROX_USAGE_EVIDENCE_DIR=%h/.local/share/prox/usage-evidence
ExecStart=/usr/bin/ionice -c3 /usr/bin/nice -n10 bun %h/.local/share/prox/usage-jobs/usage-parity.js --previous-utc-day --matrix quick --level both --deadline 12:00Z
RuntimeMaxSec=5h30min
KillSignal=SIGINT
TimeoutStopSec=40
