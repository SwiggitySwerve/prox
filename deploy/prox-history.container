[Unit]
Description=Prox quota snapshots and forecasts
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/prox-history:dev
ContainerName=prox-history
Network=host
Volume=%h/.local/share/prox-history:/data:rw
Volume=%h/.config/cli-proxy-rerank/management-key:/run/secrets/proxy-management-key:ro
Volume=%h/.config/prox/cpa-admin-key:/run/secrets/cpa-admin-key:ro

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
