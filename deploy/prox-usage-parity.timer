# Template only: deliberately not installed or enabled by this change.
[Unit]
Description=Collect Prox usage parity evidence at 04:30 UTC

[Timer]
OnCalendar=*-*-* 04:30:00 UTC
AccuracySec=1min
# No catch-up at login during a busy/forbidden window.
Persistent=false
Unit=prox-usage-parity.service

[Install]
WantedBy=timers.target
