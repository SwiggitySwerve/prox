# Template only: deliberately not installed or enabled by this change.
[Unit]
Description=Collect Prox usage parity evidence at 05:00 UTC

[Timer]
OnCalendar=*-*-* 05:00:00 UTC
AccuracySec=1min
# No catch-up at login during a busy/forbidden window.
Persistent=false
Unit=prox-usage-parity.service

[Install]
WantedBy=timers.target
