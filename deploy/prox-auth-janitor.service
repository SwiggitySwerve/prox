[Unit]
Description=Remove orphaned CLI-Proxy auth lock files
# No start limit: a bulk delete changes the directory many times, and a tripped limit would put
# the path unit into a failed state and stop it watching. Each run is cheap and idempotent.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=%h/.local/share/prox/prox-auth-janitor.sh
