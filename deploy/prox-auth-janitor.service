[Unit]
Description=Remove orphaned CLI-Proxy auth lock files
# No start limit: a tripped limit would leave the unit failed and skip cleanups. Each run is cheap
# and idempotent; only the 10-minute timer starts it.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=%h/.local/share/prox/prox-auth-janitor.sh
