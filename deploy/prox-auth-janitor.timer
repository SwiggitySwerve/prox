[Unit]
Description=Periodic CLI-Proxy auth lock file cleanup
# The script removes only orphan locks older than 10 minutes, so running every 10 minutes is as
# prompt as watching the directories, which the proxy rewrites (cooldown state) on nearly every request.

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
Unit=prox-auth-janitor.service

[Install]
WantedBy=timers.target
